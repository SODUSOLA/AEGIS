# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=AEGIS

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://aegis_user:aegis_password@localhost:5432/aegis_db

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Security ──────────────────────────────────────────────────
# Must be a random 64-character hex string. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_SALT=REPLACE_WITH_64_CHAR_HEX_STRING

# ─── Nomba API (Sandbox) ───────────────────────────────────────
NOMBA_BASE_URL=https://api.nomba.com/v1
NOMBA_CLIENT_ID=your_nomba_client_id
NOMBA_CLIENT_SECRET=your_nomba_client_secret
NOMBA_ACCOUNT_ID=your_nomba_account_id

# ─── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Billing Scheduler ─────────────────────────────────────────
# How often the scheduler checks for due subscriptions.
# Use 60 for production (every minute). Use 10 for demo/dev.
SCHEDULER_INTERVAL_SECONDS=60

# ─── BullMQ / Queue ─────────────────────────────────────────────
# Max concurrent charge jobs processed at once per worker.
WORKER_CONCURRENCY=5

# ─── App Base URL ───────────────────────────────────────────────
# Used to build the callbackUrl required by Nomba's Order schema on every
# charge request (even server-to-server tokenized charges with no redirect).
# Local dev: use an ngrok/tunnel URL if Nomba validates reachability.
APP_BASE_URL=http://localhost:3000
