generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
}

enum PlanInterval {
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

enum FailureReason {
  INSUFFICIENT_FUNDS
  EXPIRED_CARD
  BANK_NETWORK_TIMEOUT
  INVALID_CARD
  DO_NOT_HONOR
  UNKNOWN
}

model Merchant {
  id             String         @id @default(cuid())
  businessName   String         @map("business_name")
  email          String         @unique
  apiKeyHash     String         @unique @map("api_key_hash")
  apiKeyPreview  String         @map("api_key_preview")
  webhookSecret  String         @map("webhook_secret")
  status         MerchantStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  plans             Plan[]
  customers         Customer[]
  subscriptions     Subscription[]
  transactions      Transaction[]
  webhookEndpoints  WebhookEndpoint[]

  @@map("merchants")
}

model Plan {
  id          String       @id @default(cuid())
  merchantId  String       @map("merchant_id")
  name        String
  description String?
  amountKobo  Int          @map("amount_kobo")
  currency    String       @default("NGN")
  interval    PlanInterval
  intervalDays Int?        @map("interval_days")
  isActive    Boolean      @default(true) @map("is_active")
  isDeleted   Boolean      @default(false) @map("is_deleted")
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]

  @@index([merchantId])
  @@index([merchantId, isActive, isDeleted])
  @@map("plans")
}

model Customer {
  id                 String    @id @default(cuid())
  merchantId         String    @map("merchant_id")
  email              String
  name               String?
  nombaTokenKey      String?   @map("nomba_token_key")
  nombaCustomerToken String?   @map("nomba_customer_token")
  metadata           Json?
  isDeleted          Boolean   @default(false) @map("is_deleted")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]

  @@unique([merchantId, email])
  @@index([merchantId])
  @@index([nombaTokenKey])
  @@map("customers")
}

model Subscription {
  id                   String             @id @default(cuid())
  merchantId           String             @map("merchant_id")
  customerId           String             @map("customer_id")
  planId               String             @map("plan_id")
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  trialStart           DateTime?          @map("trial_start")
  trialEnd             DateTime?          @map("trial_end")
  planChangedAt        DateTime?          @map("plan_changed_at")
  previousPlanId       String?            @map("previous_plan_id")
  balanceCreditKobo    Int                @default(0) @map("balance_credit_kobo")
  retryCount           Int                @default(0) @map("retry_count")
  nextRetryAt          DateTime?          @map("next_retry_at")
  lastFailureReason    FailureReason?     @map("last_failure_reason")
  pulseScore           Int                @default(100) @map("pulse_score")
  cancelledAt          DateTime?          @map("cancelled_at")
  cancellationReason   String?            @map("cancellation_reason")
  expiresAt            DateTime?          @map("expires_at")
  isDeleted            Boolean            @default(false) @map("is_deleted")
  deletedAt            DateTime?          @map("deleted_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  merchant     Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan         Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  events       SubscriptionEvent[]

  @@index([merchantId])
  @@index([merchantId, status])
  @@index([currentPeriodEnd, status])
  @@index([nextRetryAt, status])
  @@map("subscriptions")
}

model SubscriptionEvent {
  id             String   @id @default(cuid())
  subscriptionId String   @map("subscription_id")
  eventType      String   @map("event_type")
  fromStatus     String?  @map("from_status")
  toStatus       String?  @map("to_status")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([subscriptionId, eventType])
  @@map("subscription_events")
}

model Transaction {
  id               String            @id @default(cuid())
  merchantId       String            @map("merchant_id")
  subscriptionId   String            @map("subscription_id")
  amountKobo       Int               @map("amount_kobo")
  currency         String            @default("NGN")
  status           TransactionStatus @default(PENDING)
  idempotencyKey   String            @unique @map("idempotency_key")
  nombaReference   String?           @map("nomba_reference")
  nombaOrderId     String?           @map("nomba_order_id")
  gatewayResponse  Json?             @map("gateway_response")
  failureReason    FailureReason?    @map("failure_reason")
  failureMessage   String?           @map("failure_message")
  chargeType       String            @default("RENEWAL") @map("charge_type")
  retryAttempt     Int               @default(0) @map("retry_attempt")
  isDeleted        Boolean           @default(false) @map("is_deleted")
  deletedAt        DateTime?         @map("deleted_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  merchant     Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([merchantId])
  @@index([subscriptionId])
  @@index([nombaReference])
  @@index([idempotencyKey])
  @@map("transactions")
}

model WebhookEndpoint {
  id               String                @id @default(cuid())
  merchantId       String                @map("merchant_id")
  url              String
  secret           String
  subscribedEvents String[]              @map("subscribed_events")
  status           WebhookEndpointStatus @default(ACTIVE)
  description      String?
  isDeleted        Boolean               @default(false) @map("is_deleted")
  deletedAt        DateTime?             @map("deleted_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  merchant   Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  deliveries WebhookDelivery[]

  @@index([merchantId])
  @@index([merchantId, status])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id              String                @id @default(cuid())
  endpointId      String                @map("endpoint_id")
  eventId         String                @map("event_id")
  eventType       String                @map("event_type")
  payload         Json
  status          WebhookDeliveryStatus @default(PENDING)
  attemptCount    Int                   @default(0) @map("attempt_count")
  lastAttemptedAt DateTime?             @map("last_attempted_at")
  nextAttemptAt   DateTime?             @map("next_attempt_at")
  responseStatus  Int?                  @map("response_status")
  responseBody    String?               @map("response_body")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([endpointId])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

model InboundWebhookLog {
  id            String    @id @default(cuid())
  nombaEventId  String    @unique @map("nomba_event_id")
  eventType     String    @map("event_type")
  payload       Json
  processed     Boolean   @default(false)
  processedAt   DateTime? @map("processed_at")
  error         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([processed, createdAt])
  @@map("inbound_webhook_logs")
}
